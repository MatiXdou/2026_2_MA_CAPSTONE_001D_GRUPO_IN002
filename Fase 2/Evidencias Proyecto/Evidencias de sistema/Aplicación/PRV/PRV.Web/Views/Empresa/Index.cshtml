@{
    ViewData["Title"] = "Empresas";
}

<div class="container-fluid">

    <!-- ============================= -->
    <!-- LISTADO DE EMPRESAS -->
    <!-- ============================= -->
    <div id="panelListadoEmpresas">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h2 class="mb-1">Empresas</h2>

                <p class="text-muted mb-0">
                    Administración de empresas registradas en el PRV
                </p>
            </div>

            <button type="button"
                    class="btn btn-primary"
                    id="btnNuevaEmpresa">
                + Nueva empresa
            </button>

        </div>


        <!-- ============================= -->
        <!-- CONTENEDOR PRINCIPAL -->
        <!-- ============================= -->
        <div class="card shadow-sm">

            <!-- Buscador -->
            <div class="card-body border-bottom">

                <div class="input-group" style="max-width: 500px;">

                    <span class="input-group-text">
                        🔍
                    </span>

                    <input type="text"
                           class="form-control"
                           id="txtBuscarEmpresa"
                           placeholder="Buscar empresa..." />

                </div>

            </div>


            <!-- ============================= -->
            <!-- TABLA -->
            <!-- ============================= -->
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="tablaEmpresas">

                    <thead class="table-light">

                        <tr>
                            <th>ID</th>
                            <th>RUT</th>
                            <th>Razón Social</th>
                            <th>Email Corporativo</th>
                            <th>Teléfono</th>
                            <th>Dirección</th>
                            <th>Estado</th>
                            <th>Fecha Registro</th>
                            <th>Nombre Administrador</th>
                            <th>Email Administrador</th>
                            <th class="text-end">Acciones</th>
                        </tr>

                    </thead>


                    <tbody id="cuerpoEmpresas">

                        @foreach (var empresa in Model)
                        {
                            <tr>

                                <td>@empresa.IdEmpresa</td>

                                <td>@empresa.Rut</td>

                                <td>@empresa.RazonSocial</td>

                                <td>@empresa.EmailCorporativo</td>

                                <td>@empresa.Telefono</td>

                                <td>@empresa.Direccion</td>

                                <td>
                                    @if (empresa.Estado)
                                    {
                                        <span class="badge bg-success">
                                            Activa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactiva
                                        </span>
                                    }
                                </td>

                                <td>
                                    @empresa.FechaRegistro.ToString("dd-MM-yyyy")
                                </td>


                                <td>@empresa.NombreAdministrador</td>

                                <td>@empresa.EmailAdministrador</td>

                                <td class="text-end">

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary btn-editar"
                                            title="Editar">
                                        ✏️
                                    </button>
@* 
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger btn-eliminar"
                                            title="Eliminar">
                                        🗑️
                                    </button> *@

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- ============================= -->
            <!-- PIE -->
            <!-- ============================= -->
      @*       <div class="card-footer bg-white text-muted">

                <span id="lblCantidadEmpresas">3</span>
                empresas registradas

            </div> *@

        </div>

    </div>



    <!-- ============================= -->
    <!-- FORMULARIO EMPRESA -->
    <!-- ============================= -->
    <div id="panelFormularioEmpresa"
         style="display:none;">

        <div class="mb-4">

            <h2 class="mb-1"
                id="lblTituloFormulario">
                Nueva empresa
            </h2>

            <p class="text-muted mb-0">
                Ingrese los datos de la empresa
            </p>

        </div>


        <div class="card shadow-sm">

            <div class="card-body">

                <form id="formEmpresa">

                    <div class="row">


                        <!-- RUT -->
                        <div class="col-md-6 mb-3">

                            <label for="txtRut"
                                   class="form-label">
                                RUT
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="txtRut"
                                   required />

                        </div>


                        <!-- RAZÓN SOCIAL -->
                        <div class="col-md-6 mb-3">

                            <label for="txtRazonSocial"
                                   class="form-label">
                                Razón Social
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="txtRazonSocial"
                                   required />

                        </div>


                        <!-- EMAIL -->
                        <div class="col-md-6 mb-3">

                            <label for="txtEmail"
                                   class="form-label">
                                Email Corporativo
                            </label>

                            <input type="email"
                                   class="form-control"
                                   id="txtEmail" />

                        </div>


                        <!-- TELÉFONO -->
                        <div class="col-md-6 mb-3">

                            <label for="txtTelefono"
                                   class="form-label">
                                Teléfono
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="txtTelefono" />

                        </div>


                        <!-- DIRECCIÓN -->
                        <div class="col-md-6 mb-3">

                            <label for="txtDireccion"
                                   class="form-label">
                                Dirección
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="txtDireccion" />

                        </div>




           

                        <!-- ESTADO -->
                        <div class="col-md-6 mb-3">

                            <label for="ddlEstado"
                                   class="form-label">
                                Estado
                            </label>

                            <select class="form-select"
                                    id="ddlEstado">

                                <option value="Activa">
                                    Activa
                                </option>

                                <option value="Inactiva">
                                    Inactiva
                                </option>

                            </select>

                        </div>


                        <!-- ADMINISTRADOR EMPRESA -->
                        <div class="col-md-6 mb-3">

                            <label for="txtNombreAdministrador"
                                   class="form-label">
                                Nombre Administrador
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="txtNombreAdministrador"
                                   required />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label for="txtEmailAdministrador"
                                   class="form-label">
                                Email Administrador
                            </label>

                            <input type="email"
                                   class="form-control"
                                   id="txtEmailAdministrador"
                                   required />

                        </div>


                    </div>


                    <!-- ============================= -->
                    <!-- BOTONES -->
                    <!-- ============================= -->
                    <div class="d-flex justify-content-end gap-2">

                        <button type="button"
                                class="btn btn-secondary"
                                id="btnCancelarEmpresa">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-primary"
                                id="btnGuardarEmpresa">
                            Guardar cambios
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="~/js/empresa.js"
            asp-append-version="true">
    </script>

}