@model List<PRV.Web.Models.Empresa>

@{
    Layout = null;
    ViewData["Title"] = "Seleccionar empresa";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Seleccionar empresa - PRV</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>
    <a asp-controller="Administracion"
       asp-action="Index"
       class="acceso-empresa-admin">

        <i class="bi bi-person-circle"></i>
        <span>Acceso administración</span>

    </a>

    <div class="acceso-inicio">

        <div class="acceso-card">

            <div class="text-center mb-4">

                <div class="acceso-logo">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>

                <h1 class="acceso-titulo">
                    PRV
                </h1>

                <p class="text-muted">
                    Planificador de Recursos de Ventas
                </p>

            </div>

            <div class="text-center mb-4">

                <h4>Seleccione donde quiere comprar</h4>

        
            </div>

            <div class="d-grid gap-3 acceso-lista-empresas">

                @foreach (var empresa in Model)
                {
                    <a asp-controller="Inicio"
                       asp-action="Ingresar"
                       asp-route-idEmpresa="@empresa.IdEmpresa"
                       class="acceso-empresa">

                        <i class="bi bi-building"></i>

                        <span>
                            @empresa.RazonSocial
                        </span>

                        <i class="bi bi-chevron-right ms-auto"></i>

                    </a>
                }

            </div>

        </div>

    </div>

</body>
</html>