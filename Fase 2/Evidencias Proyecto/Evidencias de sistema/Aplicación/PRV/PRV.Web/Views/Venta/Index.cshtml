@{
    ViewData["Title"] = "Consultar Ventas";
}

<div class="container-fluid">

    <!-- Encabezado -->
    <div class="mb-4">
        <h2 class="mb-1">Consultar Ventas</h2>
        <p class="text-muted mb-0">
            Consulta las ventas registradas por rango de fechas
        </p>
    </div>


    <!-- Filtros -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label for="fechaDesde" class="form-label">
                        Desde
                    </label>

                    <input type="date"
                           id="fechaDesde"
                           class="form-control"
                           required />
                </div>


                <div class="col-md-3">
                    <label for="fechaHasta" class="form-label">
                        Hasta
                    </label>

                    <input type="date"
                           id="fechaHasta"
                           class="form-control"
                           required />
                </div>


                <div class="col-md-2">
                    <button type="button"
                            id="btnBuscar"
                            class="btn btn-primary w-100">
                        Buscar
                    </button>
                </div>


                <div class="col-md-2">
                    <button type="button"
                            id="btnLimpiar"
                            class="btn btn-secondary w-100">
                        Limpiar
                    </button>
                </div>

            </div>


            <!-- Totales -->
            <div class="row g-3 mt-2">

                <div class="col-md-3">

                    <div class="alert alert-success mb-0">

                        <div>
                            Ventas confirmadas
                        </div>

                        <strong id="totalConfirmadas">
                            $0
                        </strong>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="alert alert-warning mb-0">

                        <div>
                            Ventas anuladas
                        </div>

                        <strong id="totalAnuladas">
                            $0
                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Ventas encontradas -->
    <div class="card shadow-sm">

        <div class="card-header bg-white">
            <strong>Ventas encontradas</strong>
        </div>


        <!-- Scroll vertical -->
        <div class="table-responsive"
             style="max-height: 430px; overflow-y: auto;">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>N° Venta</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Estado</th>
                        <th>Total</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody id="tablaVentas">

                    <!-- Ventas cargadas con JavaScript -->

                </tbody>

            </table>

        </div>


        <!-- Pie -->
        <div class="card-footer bg-white">

            <span id="cantidadVentas">
                0 ventas encontradas
            </span>

        </div>

    </div>

</div>


<!-- =====================================================
     MODAL DETALLE DE VENTA
     ===================================================== -->

<div class="modal fade"
     id="modalDetalleVenta"
     tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Detalle de Venta N°
                    <span id="detalleIdVenta"></span>
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>Precio Unitario</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>

                        <tbody id="tablaDetalle">
                        </tbody>

                    </table>

                </div>


                <div class="text-end">

                    <strong>
                        Total:
                        <span id="totalDetalle">$0</span>
                    </strong>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="~/js/venta.js"></script>

}