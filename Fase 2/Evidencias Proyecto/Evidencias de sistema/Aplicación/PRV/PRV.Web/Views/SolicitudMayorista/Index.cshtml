@model List<PRV.Web.Models.Usuario>

@{
    ViewData["Title"] = "Solicitudes Mayoristas";
}

<div class="container-fluid">

    <!-- ENCABEZADO -->
    <div class="mb-4">

        <h2>Solicitudes Mayoristas</h2>

        <p class="text-muted">
            Solicitudes pendientes para acceder como cliente mayorista.
        </p>

    </div>


    <!-- TABLA -->
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>RUT</th>
                            <th>Teléfono</th>
                            <th>Estado</th>
                            <th class="text-end">Acción</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var usuario in Model)
                        {
                            <tr>

                                <td>@usuario.Nombre</td>

                                <td>@usuario.Email</td>

                                <td>@usuario.Rut</td>

                                <td>@usuario.Telefono</td>

                                <td>
                                    <span class="badge bg-warning text-dark">
                                        @usuario.TipoCliente
                                    </span>
                                </td>

                                <td class="text-end">

                                    <button type="button"
                                            class="btn btn-success btn-sm btnAprobar"
                                            data-id="@usuario.IdUsuario">

                                        <i class="bi bi-check-circle me-1"></i>
                                        Aprobar

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="~/js/solicitudMayorista.js"
            asp-append-version="true"></script>

}