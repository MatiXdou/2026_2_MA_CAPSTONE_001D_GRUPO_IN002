@{
    ViewData["Title"] = "Productos Mayorista";
}

<div class="container py-4">

    <!-- ENCABEZADO -->
    <div class="mb-4">
        <h2>Productos Disponibles</h2>

        <p class="text-muted mb-3">
            Selecciona los productos que deseas comprar.
        </p>

        <!-- INFORMACIÓN MAYORISTA -->
        <div class="alert alert-primary d-flex align-items-center" role="alert">

            <i class="bi bi-info-circle-fill me-2"></i>

            <div>
                <strong>Precio mayorista:</strong>
                disponible en compras de 3 o más productos.
            </div>

        </div>
    </div>


    <div class="row g-4">

        <!-- PRODUCTO 1 -->
        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h5 class="card-title">
                        Arroz 1 Kg
                    </h5>

                    <p class="text-muted">
                        Arroz grado 1.
                    </p>

                    <p class="mb-1">
                        <strong>Precio normal:</strong>
                        $1.500
                    </p>

                    <p class="mb-1 text-primary fs-5">
                        <strong>Precio mayorista: $1.200</strong>
                    </p>

                    <p class="mt-3">
                        <strong>Stock:</strong>
                        50
                    </p>

                </div>

                <div class="card-footer bg-white border-0">

                    <a asp-controller="Compra"
                       asp-action="Index"
                       asp-route-idProducto="1"
                       class="btn btn-primary w-100">

                        <i class="bi bi-cart-plus me-1"></i>
                        Comprar

                    </a>

                </div>

            </div>

        </div>


        <!-- PRODUCTO 2 -->
        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h5 class="card-title">
                        Aceite 1 Litro
                    </h5>

                    <p class="text-muted">
                        Aceite vegetal.
                    </p>

                    <p class="mb-1">
                        <strong>Precio normal:</strong>
                        $2.200
                    </p>

                    <p class="mb-1 text-primary fs-5">
                        <strong>Precio mayorista: $1.800</strong>
                    </p>

                    <p class="mt-3">
                        <strong>Stock:</strong>
                        35
                    </p>

                </div>

                <div class="card-footer bg-white border-0">

                    <a asp-controller="Compra"
                       asp-action="Index"
                       asp-route-idProducto="1"
                       class="btn btn-primary w-100">

                        <i class="bi bi-cart-plus me-1"></i>
                        Comprar

                    </a>

                </div>

            </div>

        </div>


        <!-- PRODUCTO 3 -->
        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h5 class="card-title">
                        Azúcar 1 Kg
                    </h5>

                    <p class="text-muted">
                        Azúcar granulada.
                    </p>

                    <p class="mb-1">
                        <strong>Precio normal:</strong>
                        $1.300
                    </p>

                    <p class="mb-1 text-primary fs-5">
                        <strong>Precio mayorista: $950</strong>
                    </p>

                    <p class="mt-3">
                        <strong>Stock:</strong>
                        40
                    </p>

                </div>

                <div class="card-footer bg-white border-0">
                    <a asp-controller="Compra"
                       asp-action="Index"
                       asp-route-idProducto="1"
                       class="btn btn-primary w-100">

                        <i class="bi bi-cart-plus me-1"></i>
                        Comprar

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>