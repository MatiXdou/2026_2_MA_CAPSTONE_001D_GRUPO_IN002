@model List<PRV.Web.Models.Producto>

@{
    ViewData["Title"] = "Productos Mayorista";
}

<div class="container py-4">

    <!-- ENCABEZADO -->
    <div class="mb-4">

        <h2>Productos Disponibles</h2>

        <p class="text-muted mb-3">
            Selecciona los productos que deseas comprar.
        </p>


        <!-- INFORMACIÓN MAYORISTA -->
        <div class="alert alert-primary d-flex align-items-center"
             role="alert">

            <i class="bi bi-info-circle-fill me-2"></i>

            <div>
                <strong>Precio mayorista:</strong>
                disponible en compras de 3 o más productos.
            </div>

        </div>

    </div>


    <div class="mb-4">
        <div class="input-group" style="max-width: 500px;">

            <span class="input-group-text">
                🔍
            </span>

            <input type="text"
                   class="form-control"
                   id="txtBuscarProducto"
                   placeholder="Buscar producto..." />

        </div>
    </div>


    <!-- PRODUCTOS -->
    <div class="row g-4">

        @foreach (var producto in Model)
        {
            <div class="col-md-4 producto-item">

                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <h5 class="card-title">
                            @producto.Nombre
                        </h5>


                        <p class="text-muted">
                            @producto.Descripcion
                        </p>


                        <p class="mb-1">

                            <strong>Precio normal:</strong>

                            $@producto.PrecioVenta.ToString("N0")

                        </p>


                        <p class="mb-1 text-primary fs-5">

                            <strong>
                                Precio mayorista:
                                $@producto.PrecioMayorista.ToString("N0")
                            </strong>

                        </p>


                        <p class="mt-3">

                            <strong>Stock:</strong>
                            @producto.Stock

                        </p>

                    </div>


                    <div class="card-footer bg-white border-0">

                        <a asp-controller="Compra"
                           asp-action="Index"
                           asp-route-idProducto="@producto.IdProducto"
                           class="btn btn-primary w-100">

                            <i class="bi bi-cart-plus me-1"></i>

                            Comprar

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>

@section Scripts {

    <script src="~/js/HomeMayorista.js"
            asp-append-version="true">
    </script>

}