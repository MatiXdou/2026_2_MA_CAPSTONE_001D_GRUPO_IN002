@model List<PRV.Web.Models.Producto>

@{
    Layout = null;
    ViewData["Title"] = "Catálogo";

    var empresa = ViewBag.Empresa;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Catálogo - PRV</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body class="bg-light">

    <!-- ENCABEZADO -->
    <div class="bg-white border-bottom">

        <div class="container py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h3 class="mb-0 fw-bold text-primary">
                        PRV
                    </h3>

                    <small class="text-muted">
                        Catálogo de productos
                    </small>

                </div>


                <a asp-controller="Inicio"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left"></i>
                    Volver

                </a>

            </div>

        </div>

    </div>


    <div class="container py-5">

        <!-- EMPRESA -->
        <div class="text-center mb-5">

            <h2 class="fw-bold">
                @empresa.RazonSocial
            </h2>

            <p class="text-muted">
                Conoce nuestros productos y precios mayoristas
            </p>

        </div>


        <!-- MENSAJE MAYORISTA -->
        <div class="alert alert-primary text-center mb-5">

            <i class="bi bi-stars me-1"></i>

            <strong>¡Compra a precio mayorista!</strong>

            Regístrate como cliente mayorista y accede
            a nuestros mejores precios.

        </div>


        <!-- PRODUCTOS -->
        <div class="row g-4">

            @foreach (var producto in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body p-4">

                            <div class="mb-3">

                                <i class="bi bi-box-seam fs-1 text-primary"></i>

                            </div>


                            <h5 class="card-title fw-bold">

                                @producto.Nombre

                            </h5>


                            <p class="card-text text-muted">

                                @producto.Descripcion

                            </p>


                            <hr />


                            <!-- PRECIO NORMAL -->
                            <div class="mb-2">

                                <span class="text-muted">
                                    Precio normal
                                </span>

                                <h5>

                                    $@producto.PrecioVenta.ToString("N0")

                                </h5>

                            </div>


                            <!-- PRECIO MAYORISTA -->
                            <div class="bg-success-subtle rounded p-3">

                                <small class="text-success fw-bold">

                                    PRECIO MAYORISTA

                                </small>


                                <h3 class="text-success fw-bold mb-0">

                                    $@producto.PrecioMayorista.ToString("N0")

                                </h3>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>


        <!-- SIN PRODUCTOS -->
        @if (Model.Count == 0)
        {
            <div class="text-center text-muted py-5">

                No hay productos disponibles en este momento.

            </div>
        }

    </div>

</body>

</html>