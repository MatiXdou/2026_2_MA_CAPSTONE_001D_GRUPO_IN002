@{
    ViewData["Title"] = "Nueva compra";

    var idProductoSeleccionado =
        ViewBag.IdProductoSeleccionado != null
            ? Convert.ToInt64(ViewBag.IdProductoSeleccionado)
            : 0;
}

<div class="container py-4">

    <div class="mb-4">

        <h2>Mis compras</h2>

        <p class="text-muted">
            Agrega los productos que deseas comprar.
        </p>

    </div>


    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <!-- PRODUCTO -->
                <div class="col-md-6">

                    <label class="form-label">
                        Producto
                    </label>

                    <select id="producto"
                            class="form-select">

                        <option value="">
                            Seleccione producto
                        </option>

                        <option value="1"
                                selected="@(idProductoSeleccionado == 1)">
                            Arroz 1 Kg - $1.200
                        </option>

                        <option value="2"
                                selected="@(idProductoSeleccionado == 2)">
                            Aceite 1 Litro - $1.800
                        </option>

                        <option value="3"
                                selected="@(idProductoSeleccionado == 3)">
                            Azúcar 1 Kg - $950
                        </option>

                    </select>

                </div>


                <!-- CANTIDAD -->
                <div class="col-md-3">

                    <label class="form-label">
                        Cantidad
                    </label>

                    <input id="cantidad"
                           type="number"
                           class="form-control"
                           value="1"
                           min="1" />

                </div>


                <!-- AGREGAR -->
                <div class="col-md-3">

                    <button type="button"
                            class="btn btn-primary w-100">

                        <i class="bi bi-plus-circle me-1"></i>
                        Agregar

                    </button>

                </div>

            </div>

        </div>

    </div>


    <!-- DETALLE COMPRA -->
    <div class="card shadow-sm">

        <div class="card-body">

            <h5 class="mb-3">
                Detalle de compra
            </h5>

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>

                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Precio</th>
                            <th>Subtotal</th>
                            <th></th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td colspan="5"
                                class="text-center text-muted">

                                No hay productos agregados.

                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>


            <div class="d-flex justify-content-end mb-4">

                <h5>
                    Total:
                    <strong>$0</strong>
                </h5>

            </div>


            <div class="d-flex justify-content-end gap-2">

                <a asp-controller="HomeMayorista"
                   asp-action="Index"
                   class="btn btn-secondary">

                    Cancelar

                </a>


                <form asp-controller="Venta"
                      asp-action="Pagar"
                      method="post">

                   @*  <button type="submit"
                            class="btn btn-success">

                        <i class="bi bi-credit-card me-1"></i>
                        Pagar

                    </button> *@

                    <button type="button"
                            class="btn btn-success">

                        <i class="bi bi-credit-card me-1"></i>
                        Pagar

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>