@{
    ViewData["Title"] = "Productos";
}

<div class="container-fluid">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Productos</h2>
            <p class="text-muted mb-0">
                Administración de productos registrados en el PRV
            </p>
        </div>

        <a href="#" class="btn btn-primary">
            + Nuevo producto
        </a>
    </div>


    <!-- Contenedor principal -->
    <div class="card shadow-sm">

        <!-- Buscador -->
        <div class="card-body border-bottom">
            <div class="input-group" style="max-width: 500px;">
                <span class="input-group-text">
                    🔍
                </span>

                <input type="text"
                       class="form-control"
                       placeholder="Buscar producto..." />
            </div>
        </div>


        <!-- Tabla -->
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>1</td>
                        <td>Notebook Lenovo</td>
                        <td>Notebook 15 pulgadas, 16 GB RAM</td>
                        <td>$599.990</td>
                        <td>12</td>

                        <td>
                            <span class="badge bg-success">
                                Activo
                            </span>
                        </td>

                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary"
                                    title="Editar">
                                ✏️
                            </button>
@* 
                            <button class="btn btn-sm btn-outline-danger"
                                    title="Eliminar">
                                🗑️
                            </button> *@
                        </td>
                    </tr>


                    <tr>
                        <td>2</td>
                        <td>Monitor Samsung</td>
                        <td>Monitor LED 24 pulgadas</td>
                        <td>$149.990</td>
                        <td>25</td>

                        <td>
                            <span class="badge bg-success">
                                Activo
                            </span>
                        </td>

                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary"
                                    title="Editar">
                                ✏️
                            </button>
@* 
                            <button class="btn btn-sm btn-outline-danger"
                                    title="Eliminar">
                                🗑️
                            </button> *@
                        </td>
                    </tr>


                    <tr>
                        <td>3</td>
                        <td>Teclado Mecánico</td>
                        <td>Teclado mecánico USB</td>
                        <td>$49.990</td>
                        <td>0</td>

                        <td>
                            <span class="badge bg-secondary">
                                Inactivo
                            </span>
                        </td>

                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary"
                                    title="Editar">
                                ✏️
                            </button>

                           @*  <button class="btn btn-sm btn-outline-danger"
                                    title="Eliminar">
                                🗑️
                            </button> *@
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>


        <!-- Pie -->
        <div class="card-footer bg-white text-muted">
            3 productos registrados
        </div>

    </div>

</div>