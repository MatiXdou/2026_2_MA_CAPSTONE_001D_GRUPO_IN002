@model List<PRV.Web.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<div class="container-fluid">

    <!-- ============================= -->
    <!-- LISTADO DE PRODUCTOS -->
    <!-- ============================= -->
    <div id="panelListadoProductos">

        <!-- Encabezado -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">Productos</h2>
                <p class="text-muted mb-0">
                    Administración de productos registrados en la empresa
                </p>
            </div>

            <button type="button"
                    class="btn btn-primary"
                    id="btnNuevoProducto">
                + Nuevo producto
            </button>
        </div>


        <!-- Contenedor principal -->
        <div class="card shadow-sm">

            <!-- Buscador -->
            <div class="card-body border-bottom">

                <div class="input-group" style="max-width: 500px;">

                    <span class="input-group-text">
                        🔍
                    </span>

                    <input type="text"
                           class="form-control"
                           id="txtBuscarProducto"
                           placeholder="Buscar producto..." />

                </div>

            </div>


            <!-- Tabla -->
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Precio normal</th>
                            <th>Precio mayorista</th>
                            <th>Stock</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>

                    </thead>


                    <tbody id="cuerpoProductos">

                        @foreach (var producto in Model)
                        {
                            <tr>

                                <td>@producto.IdProducto</td>

                                <td>@producto.Nombre</td>

                                <td>@producto.Descripcion</td>

                                <td>
                                    $@producto.PrecioVenta.ToString("N0")
                                </td>

                                <td>
                                    $@producto.PrecioMayorista.ToString("N0")
                                </td>

                                <td>@producto.Stock</td>

                                <td>
                                    @if (producto.Estado == "Activo")
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary btn-editar"
                                            title="Editar">
                                        ✏️
                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- Pie -->
            <div class="card-footer bg-white text-muted">
                @Model.Count productos registrados
            </div>

        </div>

    </div>



    <!-- ============================= -->
    <!-- FORMULARIO PRODUCTO -->
    <!-- ============================= -->
    <div id="panelFormularioProducto"
         style="display:none;">

        <div class="mb-4">

            <h2 class="mb-1"
                id="lblTituloFormulario">
                Nuevo producto
            </h2>

            <p class="text-muted mb-0">
                Ingrese los datos del producto
            </p>

        </div>


        <div class="card shadow-sm">

            <div class="card-body">

                <form id="formProducto">

                    <div class="row">


                        <!-- NOMBRE -->
                        <div class="col-md-6 mb-3">

                            <label for="txtNombre"
                                   class="form-label">
                                Nombre
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="txtNombre"
                                   required />

                        </div>


                        <!-- DESCRIPCIÓN -->
                        <div class="col-md-6 mb-3">

                            <label for="txtDescripcion"
                                   class="form-label">
                                Descripción
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="txtDescripcion" />

                        </div>


                        <!-- PRECIO NORMAL -->
                        <div class="col-md-6 mb-3">

                            <label for="txtPrecioVenta"
                                   class="form-label">
                                Precio normal
                            </label>

                            <input type="number"
                                   class="form-control"
                                   id="txtPrecioVenta"
                                   min="0"
                                   required />

                        </div>


                        <!-- PRECIO MAYORISTA -->
                        <div class="col-md-6 mb-3">

                            <label for="txtPrecioMayorista"
                                   class="form-label">
                                Precio mayorista
                            </label>

                            <input type="number"
                                   class="form-control"
                                   id="txtPrecioMayorista"
                                   min="0"
                                   required />

                        </div>


                        <!-- STOCK -->
                        <div class="col-md-6 mb-3">

                            <label for="txtStock"
                                   class="form-label">
                                Stock
                            </label>

                            <input type="number"
                                   class="form-control"
                                   id="txtStock"
                                   min="0"
                                   required />

                        </div>


                        <!-- ESTADO -->
                        <div class="col-md-6 mb-3">

                            <label for="ddlEstado"
                                   class="form-label">
                                Estado
                            </label>

                            <select class="form-select"
                                    id="ddlEstado">

                                <option value="Activo">
                                    Activo
                                </option>

                                <option value="Inactivo">
                                    Inactivo
                                </option>

                            </select>

                        </div>


                    </div>


                    <!-- ============================= -->
                    <!-- BOTONES -->
                    <!-- ============================= -->
                    <div class="d-flex justify-content-end gap-2">

                        <button type="button"
                                class="btn btn-secondary"
                                id="btnCancelarProducto">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            Guardar cambios
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="~/js/producto.js"
            asp-append-version="true">
    </script>

}