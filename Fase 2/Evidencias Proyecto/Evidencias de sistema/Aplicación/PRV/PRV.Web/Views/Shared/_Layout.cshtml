<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - PRV</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/PRV.Web.styles.css"
          asp-append-version="true" />
</head>

<body>

    <div class="app-container">

        <!-- =========================
             SIDEBAR
        ========================== -->
        <aside class="sidebar">

            <div class="sidebar-brand">

                <div class="brand-icon">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>

                <div>
                    <div class="brand-title">PRV</div>

                    <div class="brand-subtitle">
                        Planificador de Recursos de Ventas
                    </div>
                </div>

            </div>


            <nav class="sidebar-menu">



           
            @* Super administrador *@
            @if (Context.Session.GetString("IdRol") == "1")
            {
                <a asp-controller="Empresa"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-buildings"></i>
                    <span>Mantenedor Empresas</span>

                </a>
            }

            @* Cliente mayorista *@
            @if (Context.Session.GetString("TipoCliente") == "Mayorista")
            {
                <a asp-controller="HomeMayorista"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-cart-check"></i>
                    <span>Comprar</span>

                </a>
            }

           @* administrador empresa *@
          @if (Context.Session.GetString("IdRol") == "2")
            {
                  <a asp-controller="Producto"
                       asp-action="Index"
                       class="menu-item">

                        <i class="bi bi-box-seam"></i>
                        <span>Mantenedor Productos</span>

                    </a>

                    <a asp-controller="SolicitudMayorista"
                       asp-action="Index"
                       class="menu-item">

                        <i class="bi bi-person-check"></i>
                        <span>Solicitudes Mayoristas</span>

                    </a>



                <a asp-controller="Venta"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-cart3"></i>
                    <span>Consultar Ventas</span>

                </a>


            }



                <div class="menu-divider"></div>


                <div class="menu-label">
                    USUARIO
                </div>


               <a asp-controller="Cuenta"
                   asp-action="index"
                   class="menu-item">

                    <i class="bi bi-person-gear"></i>
                    <span>Cambiar clave</span>

                </a>

            </nav>

        </aside>


        <!-- =========================
             ÁREA PRINCIPAL
        ========================== -->
        <div class="main-area">

            <!-- =========================
                 TOPBAR
            ========================== -->
            <header class="topbar">

                <div></div>


                <div class="topbar-right">

                    <!-- ÚNICO BOTÓN MENÚ -->
                    <button id="btnSidebar"
                            class="btn btn-light sidebar-toggle"
                            type="button"
                            title="Mostrar u ocultar menú">

                        <i class="bi bi-list"></i>

                    </button>


                    <!-- NOTIFICACIONES -->
                @*     <button class="btn btn-light topbar-icon"
                            type="button"
                            title="Notificaciones">

                        <i class="bi bi-bell"></i>

                    </button> *@


                    <!-- USUARIO -->
              <div class="dropdown">

            <div class="user-info"
                 data-bs-toggle="dropdown"
                 aria-expanded="false"
                 style="cursor: pointer;">

    @*     <div class="user-avatar">
            A
        </div> *@


        @{
            var idRol = Context.Session.GetString("IdRol");

            var perfil = idRol == "1"
                ? "SuperAdministrador"
                : idRol == "2"
                    ? "Administrador"
                    : "Mayorista";
        }

        <div class="user-text">

      <span class="user-name">
            @Context.Session.GetString("Nombre")
        </span>

        <span class="user-role">
          @perfil
        </span>

        </div>

        <i class="bi bi-chevron-down"></i>

    </div>


    <ul class="dropdown-menu dropdown-menu-end">

        <li>
            <a asp-controller="Administracion"
               asp-action="Salir"
               class="dropdown-item">

                <i class="bi bi-box-arrow-right me-2"></i>
                Salir

            </a>
        </li>

    </ul>

</div>

                </div>

            </header>


            <!-- =========================
                 CONTENIDO DE CADA VISTA
            ========================== -->
            <main class="page-content">

                @RenderBody()

            </main>

        </div>

    </div>


    <!-- =========================
         JAVASCRIPT
    ========================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>